<Project Sdk="Microsoft.NET.Sdk">

  <!-- Modo disco (ADR-010): aplica operaciones a un .mxd con ArcMap sin tocar ese documento,
       con los MISMOS handlers del add-in. Mismo target que el add-in (net45, x86: ArcObjects
       de Desktop es 32-bit). Viaja dentro del .esriaddin, junto a ArcmapMcp.AddIn.dll. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net45</TargetFramework>
    <!-- Igual que en ArcmapMcp.AddIn.csproj: la versión de ArcGIS se pasa por
         parámetro (-p:ArcGISVersion=10.8) y las rutas del GAC se derivan de ella. -->
    <ArcGISVersion Condition="'$(ArcGISVersion)' == ''">10.5</ArcGISVersion>
    <ArcGISGacVersion>$(ArcGISVersion).0.0</ArcGISGacVersion>
    <ArcGISGacDir Condition="'$(ArcGISGacDir)' == ''">C:\Windows\Microsoft.NET\assembly\GAC_MSIL</ArcGISGacDir>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>ArcmapMcp.Disco</RootNamespace>
    <AssemblyName>arcmap-mcp-disco</AssemblyName>
    <Version>2.18.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArcmapMcp.AddIn\ArcmapMcp.AddIn.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ESRI.ArcGIS.Version">
      <HintPath>$(ArcGISGacDir)\ESRI.ArcGIS.Version\v4.0_$(ArcGISGacVersion)__8fc3cc631e44ad86\ESRI.ArcGIS.Version.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ESRI.ArcGIS.System">
      <HintPath>$(ArcGISGacDir)\ESRI.ArcGIS.System\v4.0_$(ArcGISGacVersion)__8fc3cc631e44ad86\ESRI.ArcGIS.System.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ESRI.ArcGIS.Carto">
      <HintPath>$(ArcGISGacDir)\ESRI.ArcGIS.Carto\v4.0_$(ArcGISGacVersion)__8fc3cc631e44ad86\ESRI.ArcGIS.Carto.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ESRI.ArcGIS.Geodatabase">
      <HintPath>$(ArcGISGacDir)\ESRI.ArcGIS.Geodatabase\v4.0_$(ArcGISGacVersion)__8fc3cc631e44ad86\ESRI.ArcGIS.Geodatabase.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ESRI.ArcGIS.Display">
      <HintPath>$(ArcGISGacDir)\ESRI.ArcGIS.Display\v4.0_$(ArcGISGacVersion)__8fc3cc631e44ad86\ESRI.ArcGIS.Display.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ESRI.ArcGIS.Geometry">
      <HintPath>$(ArcGISGacDir)\ESRI.ArcGIS.Geometry\v4.0_$(ArcGISGacVersion)__8fc3cc631e44ad86\ESRI.ArcGIS.Geometry.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
