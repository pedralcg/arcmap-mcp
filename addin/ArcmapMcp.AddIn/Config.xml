<ESRI.Configuration xmlns="http://schemas.esri.com/Desktop/AddIns"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <Name>arcmap-mcp</Name>
  <AddInID>{51f4ce63-6bcf-49b2-ae3a-ba2c79ea3e1a}</AddInID>
  <Description>Levanta/para el puente MCP dentro de ArcMap (socket 127.0.0.1:27179, o el puerto de ARCMAP_BRIDGE_PORT; siempre en local). Permite conducir la sesion viva de ArcMap desde un agente IA (Claude, etc.). Autor: Pedro Alcoba Gómez (pedralcg.dev).</Description>
  <Version>2.18.0</Version>
  <Author>Pedro Alcoba Gómez — pedralcg.dev · pedro@pedralcg.dev · GitHub @pedralcg</Author>
  <Company>pedralcg.dev</Company>
  <Date>2026-09-20</Date>
  <Targets>
    <Target name="Desktop" version="10.5" />
  </Targets>

  <AddIn language="CLR4.5" library="ArcmapMcp.AddIn.dll" namespace="ArcmapMcp.AddIn">
    <ArcMap>

      <Extensions>
        <Extension id="pedralcg_arcmap_mcp_Extension"
                   class="McpExtension"
                   productName="arcmap-mcp"
                   showInExtensionDialog="false"
                   autoLoad="true" />
      </Extensions>

      <!-- Las cinco acciones son UN desplegable y no cinco botones: el texto de un
           Button solo lo lee ArcMap al construir el control, asi que no se puede
           retraducir sin reiniciar. ComboBox si se rehace con Clear+Add. -->
      <Commands>
        <ComboBox id="pedralcg_arcmap_mcp_Acciones"
                  class="AccionComboBox"
                  message="Elige la accion que quieres ejecutar sobre el puente MCP."
                  caption="Acciones"
                  tip="Acciones del puente MCP: iniciar, detener, estado, reportar, acerca de"
                  image="Images/start.png"
                  category="arcmap-mcp"
                  sizeString="Acciones________"
                  itemSizeString="Acciones________"
                  hintText="Acciones"
                  editable="false"
                  rows="6"
                  onDemand="false" />
        <ComboBox id="pedralcg_arcmap_mcp_AutoStart"
                  class="AutoStartComboBox"
                  message="Elige si el puente MCP debe iniciarse solo al abrir ArcMap."
                  caption="Autoarranque"
                  tip="Iniciar el puente automaticamente al abrir ArcMap (preferencia por usuario)"
                  image="Images/autostart.png"
                  category="arcmap-mcp"
                  sizeString="Autoarranque: No___"
                  itemSizeString="Autoarranque: No___"
                  hintText="Autoarranque"
                  editable="false"
                  rows="2"
                  onDemand="false" />
        <ComboBox id="pedralcg_arcmap_mcp_Language"
                  class="CambioIdiomaComboBox"
                  message="Elige el idioma de la interfaz del add-in."
                  caption="Idioma"
                  tip="Idioma de la interfaz del add-in (preferencia por usuario)"
                  image="Images/lang.png"
                  category="arcmap-mcp"
                  sizeString="Idioma: Español____"
                  itemSizeString="Idioma: Español____"
                  hintText="Idioma"
                  editable="false"
                  rows="2"
                  onDemand="false" />
      </Commands>

      <Toolbars>
        <Toolbar id="pedralcg_arcmap_mcp_Toolbar" caption="arcmap-mcp" showInitially="false">
          <Items>
            <ComboBox refID="pedralcg_arcmap_mcp_Acciones" separator="false" />
            <ComboBox refID="pedralcg_arcmap_mcp_AutoStart" separator="true" />
            <ComboBox refID="pedralcg_arcmap_mcp_Language" separator="false" />
          </Items>
        </Toolbar>
      </Toolbars>

    </ArcMap>
  </AddIn>
</ESRI.Configuration>
